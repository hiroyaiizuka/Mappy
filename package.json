{
  "name": "mappy",
  "version": "0.4.4",
  "private": true,
  "description": "A Markdown-first mind map for Obsidian.",
  "main": "main.js",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "validate": "node scripts/validate-release.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "package": "npm run build && node scripts/package-plugin.mjs && node scripts/validate-release.mjs --artifacts",
    "check": "npm run validate && npm run lint && npm test && npm run package && npm run harness:browser:build",
    "harness:prepare": "npm run check && node scripts/prepare-test-vault.mjs",
    "harness:preflight": "node scripts/preflight.mjs",
    "harness:view-teardown": "node scripts/check-view-teardown.mjs",
    "harness:e2e": "node scripts/e2e/run.mjs",
    "harness:e2e:add-delete": "node scripts/e2e/add-delete.mjs",
    "harness:e2e:delete-selection": "node scripts/e2e/delete-selection.mjs",
    "harness:e2e:undo-redo": "node scripts/e2e/undo-redo.mjs",
    "harness:e2e:deep-branches": "node scripts/e2e/deep-branches.mjs",
    "harness:e2e:convert-to-list": "node scripts/e2e/convert-to-list.mjs",
    "harness:e2e:move-parent-text": "node scripts/e2e/move-parent-text.mjs",
    "harness:e2e:paste": "node scripts/e2e/paste-image.mjs",
    "harness:e2e:layout-switch": "node scripts/e2e/layout-switch.mjs",
    "harness:e2e:undo-ids": "node scripts/e2e/undo-ids.mjs",
    "harness:e2e:embed-own-writes": "node scripts/e2e/embed-own-writes.mjs",
    "harness:e2e:embed-record-takeback": "node scripts/e2e/embed-record-takeback.mjs",
    "harness:e2e:view-reread-takeback": "node scripts/e2e/view-reread-takeback.mjs",
    "harness:e2e:call-own-writes": "node scripts/e2e/call-own-writes.mjs",
    "harness:e2e:call-rename": "node scripts/e2e/call-rename.mjs",
    "harness:e2e:line-break": "node scripts/e2e/line-break.mjs",
    "harness:e2e:multiline-setext": "node scripts/e2e/multiline-setext.mjs",
    "harness:e2e:new-node": "node scripts/e2e/new-node-input.mjs",
    "harness:e2e:excalidraw-frame": "node scripts/e2e/excalidraw-frame.mjs",
    "harness:e2e:excalidraw-lifecycle": "node scripts/e2e/excalidraw-lifecycle.mjs",
    "harness:e2e:timeline-stage-gap": "node scripts/e2e/timeline-stage-gap.mjs",
    "harness:e2e:timeline-gap-range": "node scripts/e2e/timeline-gap-range.mjs",
    "harness:e2e:timeline-large": "node scripts/e2e/timeline-large.mjs",
    "harness:e2e:theme": "node scripts/e2e/theme.mjs",
    "harness:e2e:view-lifecycle": "node scripts/e2e/view-lifecycle.mjs",
    "harness:e2e:popout": "node scripts/e2e/popout.mjs",
    "harness:e2e:drag-viewport": "node scripts/e2e/drag-viewport.mjs",
    "harness:e2e:drop-flicker": "node scripts/e2e/drop-flicker.mjs",
    "harness:e2e:own-write-flicker": "node scripts/e2e/own-write-flicker.mjs",
    "harness:e2e:window-blur-draft": "node scripts/e2e/window-blur-draft.mjs",
    "harness:e2e:node-tooltip": "node scripts/e2e/node-tooltip.mjs",
    "harness:e2e:reread-own-writes": "node scripts/e2e/reread-own-writes.mjs",
    "harness:e2e:close-draft": "node scripts/e2e/close-draft.mjs",
    "harness:e2e:indent-unit": "node scripts/e2e/indent-unit.mjs",
    "harness:e2e:english-ui": "node scripts/e2e/english-ui.mjs",
    "harness:e2e:main-topic": "node scripts/e2e/main-topic.mjs",
    "harness:e2e:central-topic": "node scripts/e2e/central-topic.mjs",
    "harness:e2e:visible-layouts": "node scripts/e2e/visible-layouts.mjs",
    "harness:e2e:view-padding": "node scripts/e2e/view-padding.mjs",
    "harness:e2e:reread-conflict-line": "node scripts/e2e/reread-conflict-line.mjs",
    "harness:e2e:panzoom-frames": "node scripts/e2e/panzoom-frames.mjs",
    "harness:e2e:memory-procedure": "node scripts/e2e/memory-procedure.mjs",
    "harness:browser": "node scripts/browser-harness.mjs --serve",
    "harness:browser:build": "node scripts/browser-harness.mjs",
    "harness:browser:capture": "node scripts/browser-harness-capture.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/json": "0.14.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.15.17",
    "@vitest/coverage-v8": "5.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "^17.6.0",
    "jsdom": "30.0.1",
    "obsidian": "1.8.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@lezer/markdown": "1.7.2"
  }
}
